{
  "_about": "Tuning numbers ported from the web prototype (scenarios.js and engine source; scenario_spec.md). Units: metres, seconds, km/h. u = metres the player's front bumper is past the section start. x = lateral metres: player lane centre 2.1, right curb about 4.15, oncoming lane centre -2.1. Painted guides, highlight zones and hazard rings were removed from the design and are not listed.",
  "engine": {
    "gearsKmh": [0, 30, 50, 80],
    "slowerStepSeconds": 1.0,
    "fasterStepSeconds": 1.5,
    "minChangeRateKmhPerSecond": 1.0,
    "rearEnd": {
      "_rule": "Tapping Slower while speed > target + toleranceKmh fails rear_ended. During an emergency (ambulance pull-over, hazard step-out) the tap is queued instead.",
      "toleranceKmh": 0.5
    },
    "speedLimit": {
      "_rule": "Over limit + toleranceKmh for longer than graceSeconds fails speeding. The road limit applies from section start + startOffset (first section: startOffsetFirst) to the next section's start + startOffset.",
      "toleranceKmh": 0.5,
      "graceSeconds": 1.5,
      "startOffset": 20,
      "startOffsetFirst": -45
    },
    "carLengthMetres": 4.4,
    "pullOverLateralRate": 2.0,
    "look": {
      "maxRadians": 1.4,
      "swipeGain": 2.4,
      "_swipeGain": "yaw += swipeGain * pixels / focal length",
      "smoothingRate": 10,
      "lookedSideDegreesWhileStopped": 20,
      "lookingAwayDegrees": 25
    },
    "nudgeGo": {
      "_rule": "Stopped longer than stoppedSeconds with no hazard holding, and nothing said for quietSeconds: say nudge_go, repeat every repeatSeconds.",
      "stoppedSeconds": 7,
      "quietSeconds": 4,
      "repeatSeconds": 7
    },
    "voiceDelaySeconds": 0.5,
    "captionSeconds": 4.5,
    "failCaptionSeconds": 6.0,
    "signScale": 1.35,
    "signBottomMetres": 2.0
  },
  "modes": {
    "practice": {
      "timeLimitSeconds": 300,
      "coaching": true,
      "pauseAndExplain": {
        "pauseKinds": ["cue", "alert", "tip", "info"],
        "noPauseKinds": ["praise", "go", "fail"],
        "noPauseLines": ["nudge_go"],
        "alertDelaySeconds": 0.5
      }
    },
    "finalTest": {
      "scenarioCount": 5,
      "calmRoadMetres": 110,
      "_calmRoad": "about 8 s at 50 km/h before each scenario",
      "timeLimitSeconds": 900,
      "_timeLimit": "for the whole test, not per retry",
      "coaching": false,
      "spokenKinds": ["fail", "info"],
      "retries": "unlimited, restart the failed scenario (checkpoint)"
    },
    "resultsKept": 20
  },
  "scenarios": [
    {
      "id": "stop",
      "unityEnum": "StopSign",
      "name": "Stop sign",
      "lengthMetres": 150,
      "limitKmh": 50,
      "control": "stop sign at u = stopLine, x 5.4",
      "stopLine": 95,
      "stopLineDepth": 0.6,
      "intersectionCentre": 101,
      "enteredAfter": 97,
      "validStop": { "from": 85, "to": 96.5 },
      "stopLookWithinMetres": 5,
      "stopTooFar": { "beforeLineMetres": 10, "stoppedSeconds": 1.2 },
      "cueAt": 20,
      "hintCar": { "at": 30, "fromSide": "right", "startDistance": 44, "speed": 10.5 },
      "crossTraffic": {
        "_rule": "Starts when the player stops. Each car picks a random side. Cars heading right use lane intersectionCentre - 2.5, cars heading left use + 2.5.",
        "countWeights": [0.4, 0.4, 0.2],
        "_countWeights": "chance of 1, 2 or 3 cars",
        "firstCarDistance": { "from": 32, "to": 52 },
        "laterCarDistance": 70,
        "laterCarDelay": { "from": 0.5, "to": 3.0 },
        "lastCarLateChance": 0.4,
        "lateCarDelay": { "from": 3.0, "to": 4.5 },
        "speed": 9,
        "laneOffset": 2.5,
        "hazardHeight": 1.5
      },
      "conflict": {
        "_rule": "A crossing car conflicts if it overlaps the path strip now, or reaches it before the player's rear clears its lane (at max(speed, 4 m/s)) plus marginSeconds.",
        "pathX": { "from": 0.6, "to": 3.6 },
        "marginSeconds": 0.5,
        "minClearSpeed": 4
      },
      "hitCheckUntil": 113,
      "doneAt": 109,
      "lines": { "cue": "stop_cue", "look": "stop_look", "early": "stop_early", "tooFar": "stop_toofar", "done": "stop_done", "tip": "stop_tip" },
      "fails": [
        { "rule": "u > validStop.to without a full stop", "code": "rolled_stop", "line": "stop_fail_rolled" },
        { "rule": "u > enteredAfter with a conflicting car", "code": "entered_with_traffic", "line": "stop_fail_traffic" },
        { "rule": "overlap with a crossing car before hitCheckUntil", "code": "hit_cross_traffic", "line": "stop_fail_hit" }
      ]
    },
    {
      "id": "hidden_ped",
      "unityEnum": "HiddenCrossing",
      "name": "Parked truck",
      "lengthMetres": 150,
      "limitKmh": 50,
      "variants": { "pedestrian": { "chance": 0.5, "speed": 1.5, "hazardHeight": 1.7 }, "dog": { "chance": 0.5, "speed": 1.8, "hazardHeight": 0.8 } },
      "truck": { "from": 62, "to": 73.5, "xFrom": 4.4, "xTo": 6.8 },
      "noSceneryRight": { "from": 55, "to": 88 },
      "stepOutPoint": 75.3,
      "startX": 5.0,
      "endX": -6.5,
      "peek": { "from": 28, "periodSeconds": 2.6, "outSeconds": 0.8, "x": 4.6 },
      "stepOutWhenWithinMetres": 23.5,
      "inRoadBelowX": 4.5,
      "clearAtX": -0.6,
      "hitCheckBefore": 0.4,
      "doneAt": 85,
      "lines": { "cue": "ped_cue", "out": "ped_out", "dog": "ped_dog", "clear": "ped_clear", "dogClear": "ped_dog_clear", "done": "ped_done" },
      "fails": [
        { "rule": "front passes stepOutPoint - hitCheckBefore while it is in the road (x < inRoadBelowX, not yet past clearAtX)", "code": "hit_pedestrian / hit_animal", "line": "ped_fail_hit / ped_fail_dog" },
        { "rule": "same, but the player was already at 30 or below when it stepped out", "code": "hit_pedestrian / hit_animal", "line": "ped_fail_late" }
      ]
    },
