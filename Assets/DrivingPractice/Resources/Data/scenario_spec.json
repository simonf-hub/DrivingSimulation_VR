      "signalOffset": 5,
      "flashPeriodSeconds": 1.0,
      "lines": { "cue": "fr_cue", "look": "stop_look", "early": "stop_early", "tooFar": "stop_toofar", "done": "fr_done", "tip": "stop_tip" },
      "fails": [
        { "rule": "u > validStop.to without a full stop", "code": "rolled_flashing_red", "line": "fr_fail_rolled" },
        { "rule": "u > enteredAfter with a conflicting car", "code": "entered_with_traffic", "line": "stop_fail_traffic" },
        { "rule": "overlap with a crossing car before hitCheckUntil", "code": "hit_cross_traffic", "line": "stop_fail_hit" }
