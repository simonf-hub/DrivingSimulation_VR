      "doneAt": 210,
      "lines": { "cue": "lead_cue", "brake": "lead_brake", "done": "lead_done", "doneSlow": "lead_done_slow" },
      "fails": [
        { "rule": "gap <= 0", "code": "hit_lead_car", "line": "lead_fail_hit" },
        { "rule": "headway < headway.minSeconds for longer than headway.graceSeconds", "code": "too_close", "line": "lead_fail_close" }
      ]
    },
    {
      "id": "flashing_red",
      "unityEnum": "FlashingRed",
      "name": "Flashing red light",
      "sameAs": "stop",
