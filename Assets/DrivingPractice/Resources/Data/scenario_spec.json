      "fails": [
        { "rule": "front reaches crossingPoint - hitCheckBefore while the child is in the lane (x < child.clearAtX)", "code": "entered_with_child", "line": "pg_fail_child" },
        { "rule": "over zone.limitKmh in the zone for longer than zone.graceSeconds", "code": "speeding", "line": "pg_fail_speed" }
      ]
    },
    {
      "id": "lead_car",
      "unityEnum": "Expressway",
      "name": "80 zone, car braking",
      "lengthMetres": 260,
      "limitKmh": 80,
      "leadCar": {
        "startAhead": 70,
        "startKmh": 60,
        "_cruise": "Before braking: stays about 45-70 m ahead. Speed = clamp(playerSpeed - (gap - 45) * 0.3 m/s, floor, 80 km/h), floor = clamp(60 - (gap - 55) * 2, 30, 60) km/h.",
        "cruiseTargetGap": 45,
